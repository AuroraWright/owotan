+std::optional<std::string> DictionaryQuery::query_glossary(const std::string& dict_name, uint64_t offset) const {
+  for (const auto& dict : term_dicts_) {
+    if (dict.name != dict_name) {
+      continue;
+    }
+    const auto& data = dict.data;
+    if (offset >= data->blobs.size()) {
+      return std::nullopt;
+    }
+    BlobPins pins;
+    std::optional<std::string> glossary;
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto blob = open(offset);
+      if (read_value<uint8_t>(blob) != 0) {
+        return;
+      }
+      blob.skip(read_value<uint16_t>(blob));
+      blob.skip(read_value<uint16_t>(blob));
+      const auto glossary_offset = read_value<uint64_t>(blob);
+      const auto glossary_size = read_value<uint32_t>(blob);
+      glossary = decompress_glossary(data->blobs.range(glossary_offset, glossary_size, pins), glossary_size,
+                                     data->zstd_dict);
+    });
+    return glossary;
+  }
+  return std::nullopt;
