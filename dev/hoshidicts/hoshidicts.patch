+std::vector<TermRow> DictionaryQuery::query_sequence_rows(const std::string& dict_name, int64_t sequence) const {
+  std::vector<TermRow> rows;
+  const std::string key = yomitan_parser::sequence_key(sequence);
+  BlobPins pins;
+  for (const auto& dict : term_dicts_) {
+    if (dict.name != dict_name) {
+      continue;
+    }
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->version >= 7 ? data->table(key) : 0;
+    if (offset_addr == 0) {
+      break;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        // The key's hash may be an expression's too.
+        if (read_term_row(open, read_value<uint64_t>(index), dict.name,
+                          [](std::string_view, std::string_view) { return true; }, rows) &&
+            rows.back().sequence != sequence) {
+          rows.pop_back();
+        }
+      }
+    });
+    break;
+  }
+  return rows;
+}
