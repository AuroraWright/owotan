+
+bool yomitan_parser::parse_glossary_redirects(std::string_view glossary, std::vector<GlossaryRedirect>& redirects,
+                                              size_t& content_count) {
+  std::vector<hoshidicts::raw_value_view> items;
+  if (glz::read<bank_opts>(items, glossary)) {
+    return false;
+  }
+  content_count = 0;
+  for (const auto& item : items) {
+    if (!item.str.starts_with('[')) {
+      ++content_count;
+      continue;
+    }
+    std::tuple<std::string, std::vector<std::string>> redirect;
+    if (!glz::read<glz::opts{.error_on_unknown_keys = false}>(redirect, item.str)) {
+      redirects.push_back({std::move(std::get<0>(redirect)), std::move(std::get<1>(redirect))});
+    }
+  }
+  return true;
+}
