+namespace {
+struct RecordGlossary {
+  uint64_t offset;
+  uint32_t size;
+};
+
+// Reads a term record's fields after the glossary span, through the score.
+template <typename Reader>
+void read_term_tail(Reader& blob, int version, TermRow& row) {
+  row.definition_tags = blob.str(read_value<uint8_t>(blob));
+  row.rules = blob.str(read_value<uint8_t>(blob));
+  row.term_tags = blob.str(read_value<uint8_t>(blob));
+  if (version >= 2) {
+    auto redirect_count = read_value<uint32_t>(blob);
+    for (uint32_t r = 0; r < redirect_count; r++) {
+      TermRedirect& redirect = row.redirects.emplace_back();
+      redirect.form_of = blob.str(read_value<uint32_t>(blob));
+      auto rule_count = read_value<uint32_t>(blob);
+      for (uint32_t j = 0; j < rule_count; j++) {
+        redirect.rules.emplace_back(blob.str(read_value<uint32_t>(blob)));
+      }
+    }
+  }
+  // Before version 7 neither was stored; such a record's glossary is
+  // decompressed by whoever needs the count.
+  if (version >= 7) {
+    row.content_count = read_value<uint16_t>(blob);
+    row.sequence = read_value<int64_t>(blob);
+  }
+  if (version >= 5) {
+    row.score = read_value<double>(blob);
+  } else if (version >= 3) {
+    row.score = read_value<int32_t>(blob);
+  }
+}
+
+// Appends the term record at `offset` to `rows` when `accept` takes its
+// expression and reading, and returns where its compressed glossary is.
+template <typename Open, typename Accept>
+std::optional<RecordGlossary> read_term_row(Open& open, uint64_t offset, const std::string& dict_name, int version,
+                                            Accept&& accept, std::vector<TermRow>& rows) {
+  auto blob = open(offset);
+  if (read_value<uint8_t>(blob) != 0) {
+    return std::nullopt;
+  }
+  std::string_view expr = blob.str(read_value<uint16_t>(blob));
+  std::string_view reading = blob.str(read_value<uint16_t>(blob));
+  if (!accept(expr, reading)) {
+    return std::nullopt;
+  }
+  RecordGlossary glossary{.offset = read_value<uint64_t>(blob), .size = read_value<uint32_t>(blob)};
+  TermRow& row = rows.emplace_back();
+  row.dict_name = dict_name;
+  row.expression = expr;
+  row.reading = reading;
+  row.offset = offset;
+  read_term_tail(blob, version, row);
+  return glossary;
+}
+}  // namespace
+
+std::vector<TermRow> DictionaryQuery::query_rows(const std::string& key, bool with_glossary) const {
+  std::vector<TermRow> rows;
+  BlobPins pins;
+  for (const auto& dict : term_dicts_) {
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->table(key);
+    if (offset_addr == 0) {
+      continue;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        auto glossary = read_term_row(
+            open, read_value<uint64_t>(index), dict.name, data->version,
+            [&](std::string_view expr, std::string_view reading) { return expr == key || reading == key; }, rows);
+        if (!glossary) {
+          continue;
+        }
+        TermRow& row = rows.back();
+        row.reading_match = row.expression != key;
+        if (with_glossary) {
+          row.glossary = decompress_glossary(data->blobs.range(glossary->offset, glossary->size, pins),
+                                             glossary->size, data->zstd_dict);
+        }
+      }
+    });
+  }
+  return rows;
+}
+
+std::vector<TermRow> DictionaryQuery::query_sequence_rows(const std::string& dict_name, int64_t sequence,
+                                                          bool with_glossary) const {
+  std::vector<TermRow> rows;
+  const std::string key = yomitan_parser::sequence_key(sequence);
+  BlobPins pins;
+  for (const auto& dict : term_dicts_) {
+    if (dict.name != dict_name) {
+      continue;
+    }
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->version >= 7 ? data->table(key) : 0;
+    if (offset_addr == 0) {
+      break;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        auto glossary = read_term_row(open, read_value<uint64_t>(index), dict.name, data->version,
+                                      [](std::string_view, std::string_view) { return true; }, rows);
+        if (!glossary) {
+          continue;
+        }
+        // The key's hash may be an expression's too.
+        if (rows.back().sequence != sequence) {
+          rows.pop_back();
+          continue;
+        }
+        if (with_glossary) {
+          rows.back().glossary = decompress_glossary(data->blobs.range(glossary->offset, glossary->size, pins),
+                                                     glossary->size, data->zstd_dict);
+        }
+      }
+    });
+    break;
+  }
+  return rows;
+}
+
+std::optional<std::string> DictionaryQuery::query_glossary(const std::string& dict_name, uint64_t offset) const {
+  for (const auto& dict : term_dicts_) {
+    if (dict.name != dict_name) {
+      continue;
+    }
+    const auto& data = dict.data;
+    if (offset >= data->blobs.size()) {
+      return std::nullopt;
+    }
+    BlobPins pins;
+    std::optional<std::string> glossary;
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto blob = open(offset);
+      if (read_value<uint8_t>(blob) != 0) {
+        return;
+      }
+      blob.skip(read_value<uint16_t>(blob));
+      blob.skip(read_value<uint16_t>(blob));
+      RecordGlossary span{.offset = read_value<uint64_t>(blob), .size = read_value<uint32_t>(blob)};
+      glossary = decompress_glossary(data->blobs.range(span.offset, span.size, pins), span.size, data->zstd_dict);
+    });
+    return glossary;
+  }
+  return std::nullopt;
+}
+
+std::vector<MetaRow> DictionaryQuery::query_meta_rows(const std::string& key) const {
+  std::vector<MetaRow> rows;
+  BlobPins pins;
+  std::vector<const DictionaryData*> seen;
+  for (const auto* list : {&freq_dicts_, &pitch_dicts_}) {
+    for (const auto& dict : *list) {
+      const auto* data = dict.data.get();
+      if (std::ranges::find(seen, data) != seen.end()) {
+        continue;
+      }
+      seen.push_back(data);
+      uint64_t offset_addr = data->table(key);
+      if (offset_addr == 0) {
+        continue;
+      }
+      visit_blobs(data->blobs, pins, [&](auto open) {
+        auto index = open(offset_addr);
+        auto count = read_value<uint32_t>(index);
+        for (uint32_t i = 0; i < count; i++) {
+          auto blob = open(read_value<uint64_t>(index));
+          if (read_value<uint8_t>(blob) != 1) {
+            continue;
+          }
+          std::string_view expr = blob.str(read_value<uint16_t>(blob));
+          if (expr != key) {
+            continue;
+          }
+          std::string_view mode = blob.str(read_value<uint8_t>(blob));
+          std::string_view row_data = blob.str(read_value<uint32_t>(blob));
+          rows.push_back(MetaRow{.dict_name = dict.name,
+                                 .expression = std::string(expr),
+                                 .mode = std::string(mode),
+                                 .data = std::string(row_data)});
+        }
+      });
+    }
+  }
+  return rows;
+}
+
+std::vector<KanjiRow> DictionaryQuery::query_kanji_rows(const std::string& character) const {
+  std::vector<KanjiRow> rows;
+  BlobPins pins;
+  for (const auto& dict : kanji_dicts_) {
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->table(character);
+    if (offset_addr == 0) {
+      continue;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        auto blob = open(read_value<uint64_t>(index));
+        if (read_value<uint8_t>(blob) != 2) {
+          continue;
+        }
+        if (blob.str(read_value<uint8_t>(blob)) != character) {
+          continue;
+        }
+        KanjiRow& row = rows.emplace_back();
+        row.dict_name = dict.name;
+        row.character = character;
+        row.onyomi = blob.str(read_value<uint16_t>(blob));
+        row.kunyomi = blob.str(read_value<uint16_t>(blob));
+        row.tags = blob.str(read_value<uint16_t>(blob));
+        auto meaning_count = read_value<uint16_t>(blob);
+        for (uint16_t j = 0; j < meaning_count; j++) {
+          row.meanings.emplace_back(blob.str(read_value<uint16_t>(blob)));
+        }
+        auto stat_count = read_value<uint16_t>(blob);
+        for (uint16_t j = 0; j < stat_count; j++) {
+          std::string name(blob.str(read_value<uint16_t>(blob)));
+          row.stats.emplace(std::move(name), blob.str(read_value<uint16_t>(blob)));
+        }
+      }
+    });
+  }
+  return rows;
+}
+
+std::vector<MetaRow> DictionaryQuery::query_kanji_meta_rows(const std::string& character) const {
+  std::vector<MetaRow> rows;
+  BlobPins pins;
+  for (const auto& dict : freq_dicts_) {
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->table(character);
+    if (offset_addr == 0) {
+      continue;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        auto blob = open(read_value<uint64_t>(index));
+        if (read_value<uint8_t>(blob) != 3) {
+          continue;
+        }
+        if (blob.str(read_value<uint16_t>(blob)) != character) {
+          continue;
+        }
+        std::string_view mode = blob.str(read_value<uint8_t>(blob));
+        std::string_view row_data = blob.str(read_value<uint32_t>(blob));
+        rows.push_back(MetaRow{.dict_name = dict.name,
+                               .expression = character,
+                               .mode = std::string(mode),
+                               .data = std::string(row_data)});
+      }
+    });
+  }
+  return rows;
+}
