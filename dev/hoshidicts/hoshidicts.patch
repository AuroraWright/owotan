+namespace {
+const glz::generic* find_member(const glz::generic& value, std::string_view key) {
+  return value.is_object() && value.contains(key) ? &value.at(key) : nullptr;
+}
+
+bool is_string(const glz::generic* value, std::string_view expected) {
+  return value != nullptr && value->is_string() && value->get_string() == expected;
+}
+
+void add_structured_content_image_paths(const glz::generic& content, std::vector<std::string>& paths) {
+  if (content.is_array()) {
+    for (const auto& child : content.get_array()) {
+      add_structured_content_image_paths(child, paths);
+    }
+    return;
+  }
+  if (is_string(find_member(content, "tag"), "img")) {
+    const glz::generic* path = find_member(content, "path");
+    if (path != nullptr && path->is_string()) {
+      paths.push_back(path->get_string());
+    }
+    return;
+  }
+  if (const glz::generic* child = find_member(content, "content")) {
+    add_structured_content_image_paths(*child, paths);
+  }
+}
+}  // namespace
+
+void yomitan_parser::add_glossary_image_paths(std::string_view glossary, std::vector<std::string>& paths) {
+  // Every image names a path; few glossaries do, so only those are parsed.
+  constexpr std::string_view path_key = "\"path\"";
+  if (glossary.find(path_key) == std::string_view::npos) {
+    return;
+  }
+  std::vector<hoshidicts::raw_value_view> items;
+  if (glz::read<bank_opts>(items, glossary)) {
+    return;
+  }
+  for (const auto& item : items) {
+    if (!item.str.starts_with('{') || item.str.find(path_key) == std::string_view::npos) {
+      continue;
+    }
+    glz::generic value;
+    if (glz::read_json(value, item.str)) {
+      continue;
+    }
+    const glz::generic* type = find_member(value, "type");
+    if (is_string(type, "image")) {
+      const glz::generic* path = find_member(value, "path");
+      if (path != nullptr && path->is_string()) {
+        paths.push_back(path->get_string());
+      }
+    } else if (is_string(type, "structured-content")) {
+      if (const glz::generic* content = find_member(value, "content")) {
+        add_structured_content_image_paths(*content, paths);
+      }
+    }
+  }
+}
+
+bool yomitan_parser::parse_glossary_redirects(std::string_view glossary, std::vector<GlossaryRedirect>& redirects,
+                                              size_t& content_count) {
+  std::vector<hoshidicts::raw_value_view> items;
+  if (glz::read<bank_opts>(items, glossary)) {
+    return false;
+  }
+  content_count = 0;
+  for (const auto& item : items) {
+    if (!item.str.starts_with('[')) {
+      ++content_count;
+      continue;
+    }
+    std::tuple<std::string, std::vector<std::string>> redirect;
+    if (!glz::read<glz::opts{.error_on_unknown_keys = false}>(redirect, item.str)) {
+      redirects.push_back({std::move(std::get<0>(redirect)), std::move(std::get<1>(redirect))});
+    }
+  }
+  return true;
+}
