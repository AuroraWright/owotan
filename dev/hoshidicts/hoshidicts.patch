+    for (const auto& dict : *list) {
+      const auto* data = dict.data.get();
+      if (std::ranges::find(seen, data) != seen.end()) {
+        continue;
+      }
+      seen.push_back(data);
+      uint64_t offset_addr = data->table(key);
+      if (offset_addr == 0) {
+        continue;
+      }
+      visit_blobs(data->blobs, pins, [&](auto open) {
+        auto index = open(offset_addr);
+        auto count = read_value<uint32_t>(index);
+        for (uint32_t i = 0; i < count; i++) {
+          auto blob = open(read_value<uint64_t>(index));
+          if (read_value<uint8_t>(blob) != 1) {
+            continue;
+          }
+          std::string_view expr = blob.str(read_value<uint16_t>(blob));
+          if (expr != key) {
+            continue;
+          }
+          std::string_view mode = blob.str(read_value<uint8_t>(blob));
+          std::string_view row_data = blob.str(read_value<uint32_t>(blob));
+          rows.push_back(MetaRow{.dict_name = dict.name,
+                                 .expression = std::string(expr),
+                                 .mode = std::string(mode),
+                                 .data = std::string(row_data)});
+        }
+      });
+    }
+  }
+  return rows;
+}
+
+std::vector<KanjiRow> DictionaryQuery::query_kanji_rows(const std::string& character) const {
+  std::vector<KanjiRow> rows;
+  BlobPins pins;
+  for (const auto& dict : kanji_dicts_) {
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->table(character);
+    if (offset_addr == 0) {
+      continue;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        auto blob = open(read_value<uint64_t>(index));
+        if (read_value<uint8_t>(blob) != 2) {
+          continue;
+        }
+        if (blob.str(read_value<uint8_t>(blob)) != character) {
+          continue;
+        }
+        KanjiRow& row = rows.emplace_back();
+        row.dict_name = dict.name;
+        row.character = character;
+        row.onyomi = blob.str(read_value<uint16_t>(blob));
+        row.kunyomi = blob.str(read_value<uint16_t>(blob));
+        row.tags = blob.str(read_value<uint16_t>(blob));
+        auto meaning_count = read_value<uint16_t>(blob);
+        for (uint16_t j = 0; j < meaning_count; j++) {
+          row.meanings.emplace_back(blob.str(read_value<uint16_t>(blob)));
+        }
+        auto stat_count = read_value<uint16_t>(blob);
+        for (uint16_t j = 0; j < stat_count; j++) {
+          std::string name(blob.str(read_value<uint16_t>(blob)));
+          row.stats.emplace(std::move(name), blob.str(read_value<uint16_t>(blob)));
+        }
+      }
+    });
+  }
+  return rows;
+}
+
+std::vector<MetaRow> DictionaryQuery::query_kanji_meta_rows(const std::string& character) const {
+  std::vector<MetaRow> rows;
+  BlobPins pins;
+  for (const auto& dict : freq_dicts_) {
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->table(character);
+    if (offset_addr == 0) {
+      continue;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        auto blob = open(read_value<uint64_t>(index));
+        if (read_value<uint8_t>(blob) != 3) {
+          continue;
+        }
+        if (blob.str(read_value<uint16_t>(blob)) != character) {
+          continue;
+        }
+        std::string_view mode = blob.str(read_value<uint8_t>(blob));
+        std::string_view row_data = blob.str(read_value<uint32_t>(blob));
+        rows.push_back(MetaRow{.dict_name = dict.name,
+                               .expression = character,
+                               .mode = std::string(mode),
+                               .data = std::string(row_data)});
+      }
+    });
+  }
+  return rows;
+}
