+std::vector<TermRow> DictionaryQuery::query_rows(const std::string& key) const {
+  std::vector<TermRow> rows;
+  BlobPins pins;
+  for (const auto& dict : term_dicts_) {
+    const auto& data = dict.data;
+    uint64_t offset_addr = data->version >= 7 ? data->table(key) : 0;
+    if (offset_addr == 0) {
+      continue;
+    }
+    visit_blobs(data->blobs, pins, [&](auto open) {
+      auto index = open(offset_addr);
+      auto count = read_value<uint32_t>(index);
+      for (uint32_t i = 0; i < count; i++) {
+        if (read_term_row(
+                open, read_value<uint64_t>(index), dict.name,
+                [&](std::string_view expr, std::string_view reading) { return expr == key || reading == key; }, rows)) {
+          TermRow& row = rows.back();
+          row.reading_match = row.expression != key;
+        }
+      }
+    });
+  }
+  return rows;
+}
